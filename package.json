{
  "name": "markdown-marp-reader",
  "version": "1.0.0",
  "private": true,
  "description": "Chrome extension that previews local Markdown files with images and math, and presents Marp decks.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "validate": "node scripts/validate.mjs",
    "icons": "node scripts/make-icons.mjs",
    "package": "node scripts/package.mjs",
    "check": "npm run lint && npm run format:check && npm run test:coverage && npm run build && npm run validate",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "node scripts/e2e.mjs",
    "e2e:chrome": "npx --yes @puppeteer/browsers install chrome@stable --path .chrome"
  },
  "dependencies": {
    "@marp-team/marp-core": "^4.1.0",
    "dompurify": "^3.3.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^3.0.4",
    "katex": "^0.17.0",
    "marked": "^17.0.0",
    "marked-katex-extension": "^5.1.6",
    "mermaid": "^11.17.2",
    "pptxgenjs": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@vitest/coverage-v8": "^4.0.0",
    "esbuild": "^0.27.0",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.9.10",
    "puppeteer-core": "^24.43.1",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
