{
  "manifest_version": 3,
  "name": "Markdown & Marp Reader",
  "short_name": "MD Marp Reader",
  "version": "1.0.0",
  "description": "Preview local Markdown files with images and math, and present Marp slide decks — fully offline.",
  "minimum_chrome_version": "116",
  "offline_enabled": true,
  "permissions": [],
  "action": {
    "default_title": "Open Markdown & Marp Reader",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
